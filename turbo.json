{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "headless-360-mcp#build": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"],
      "env": ["PORT"]
    },
    "lint": {
      "outputs": []
    }
  }
}
